# 采集命令(910B3 真实上板)
$ msprof --application="./demo" \
       --output="./prof_out" \
       --ai-core=on --task-time=on --aicpu=on \
       --aic-metrics=PipeUtilization \
       --analyze=on

[WARNING] The argument --analyze is useless when --application is not empty
