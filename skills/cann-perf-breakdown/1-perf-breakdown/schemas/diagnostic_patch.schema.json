{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "diagnostic_patch.schema.json",
  "type": "object",
  "required": ["schema_version", "diagnostic_kind", "outcome", "request_sha256", "base_artifacts", "diagnoses", "patches"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "diagnostic_kind": {"const": "controlled_patch"},
    "outcome": {"enum": ["proposed_patch", "insufficient_external_evidence", "tool_defect"]},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_artifacts": {"type": "object"},
    "diagnoses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["issue_id", "owner_artifact", "repair_class", "explanation"],
        "additionalProperties": false,
        "properties": {
          "issue_id": {"type": "string", "minLength": 1},
          "owner_artifact": {"type": "string", "minLength": 1},
          "repair_class": {"type": "string", "minLength": 1},
          "explanation": {"type": "string", "minLength": 1}
        }
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "operations"],
        "additionalProperties": false,
        "properties": {
          "target": {"type": "string"},
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["op", "path", "evidence"],
              "additionalProperties": false,
              "properties": {
                "op": {"enum": ["add", "replace", "remove"]},
                "path": {"type": "string", "pattern": "^/"},
                "value": {},
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["artifact", "explanation"],
                    "additionalProperties": false,
                    "properties": {
                      "artifact": {"type": "string"},
                      "explanation": {"type": "string", "minLength": 1},
                      "source_ref": {"type": "string"},
                      "op_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "diagnosed_at": {"type": "string"},
    "diagnostician": {"type": "string"}
  }
}
