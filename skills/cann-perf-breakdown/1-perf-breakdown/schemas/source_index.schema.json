{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "source_index.schema.json",
  "type": "object",
  "required": ["schema_version", "source_roots", "source_bundle_hash", "files"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "source_roots": {"type": "array", "items": {"type": "string"}},
    "source_bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "root", "root_index", "sha256", "classes", "functions"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "root": {"type": "string"},
          "root_index": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "classes": {"type": "array", "items": {"$ref": "#/definitions/class"}},
          "functions": {"type": "array", "items": {"$ref": "#/definitions/function"}}
        }
      }
    }
  },
  "definitions": {
    "range": {
      "type": ["object", "null"],
      "required": ["line_start", "line_end"],
      "additionalProperties": false,
      "properties": {
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1}
      }
    },
    "class": {
      "type": "object",
      "required": ["name", "qualname", "line_start", "line_end", "init", "forward"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"}, "qualname": {"type": "string"},
        "line_start": {"type": "integer"}, "line_end": {"type": "integer"},
        "init": {"$ref": "#/definitions/range"},
        "forward": {"$ref": "#/definitions/range"}
      }
    },
    "function": {
      "type": "object",
      "required": ["name", "qualname", "kind", "line_start", "line_end"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"}, "qualname": {"type": "string"},
        "kind": {"enum": ["function", "method"]},
        "line_start": {"type": "integer"}, "line_end": {"type": "integer"}
      }
    }
  }
}
