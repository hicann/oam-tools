{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semantic_review.schema.json",
  "title": "Source and trace semantic review for a model breakdown",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "artifacts",
    "source_evidence",
    "checks",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "unknown"
      ]
    },
    "reviewed_at": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "revision_note": {
      "type": "string",
      "description": "Present ONLY when the verdicts below were produced against an earlier config revision and carried forward after a targeted correction, instead of Step 8 being re-run. The hash binding proves the review matches the current config bytes; it cannot show that a human or AI actually re-examined them, so a carried-forward review is otherwise indistinguishable from a fresh one. State what changed, why the verdicts still hold, and that Step 8 was not re-run."
    },
    "artifacts": {
      "type": "object",
      "required": [
        "analysis_config",
        "raw_ops",
        "model_manifest"
      ],
      "additionalProperties": false,
      "properties": {
        "analysis_config": {
          "$ref": "#/definitions/artifact"
        },
        "raw_ops": {
          "$ref": "#/definitions/artifact"
        },
        "model_manifest": {
          "$ref": "#/definitions/artifact"
        },
        "dataflow_source": {
          "$ref": "#/definitions/artifact",
          "description": "dataflow_source.json from extract_dataflow.py. Not in `required`: a review of a model whose source was unavailable has no dataflow truth to bind. When the runner DOES supply one, validate_semantic_review reports SR_DATAFLOW_UNBOUND if this is missing -- so it is optional in the schema and mandatory whenever the artifact exists."
        }
      }
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/source_evidence"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 9,
      "items": {
        "$ref": "#/definitions/check"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      }
    }
  },
  "definitions": {
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_evidence": {
      "type": "object",
      "required": [
        "source_ref",
        "explanation"
      ],
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "explanation"
      ],
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "config_path": {
          "type": "string"
        },
        "op_indices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "status",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/evidence"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "check_id",
        "message",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "check_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/evidence"
          }
        }
      }
    }
  }
}
